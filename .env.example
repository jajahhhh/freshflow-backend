# SQLite ใช้เริ่ม demo บนเครื่องได้ทันที; เปลี่ยน DATABASE_URL เพื่อใช้ MySQL
DATABASE_URL=sqlite:///./freshflow.db
ADMIN_API_KEY=replace_with_a_long_random_admin_key
STAFF_API_KEY=replace_with_a_different_long_random_staff_key
SERVICE_API_KEY=replace_with_a_different_long_random_service_key
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
