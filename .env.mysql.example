# คัดลอกเป็น .env.mysql และเปลี่ยนรหัสผ่านกับ API keys ก่อนใช้
MYSQL_DATABASE=freshflow
MYSQL_USER=freshflow_app
MYSQL_PASSWORD=replace_with_local_app_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
MYSQL_PORT=3307

# รหัสผ่านใน URL ต้องตรง MYSQL_PASSWORD; percent-encode หากมีอักขระพิเศษใน URL
DATABASE_URL=mysql+pymysql://freshflow_app:replace_with_local_app_password@127.0.0.1:3307/freshflow?charset=utf8mb4
ADMIN_API_KEY=replace_with_a_long_random_admin_key
STAFF_API_KEY=replace_with_a_different_long_random_staff_key
SERVICE_API_KEY=replace_with_a_different_long_random_service_key
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
