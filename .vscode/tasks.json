{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FreshFlow: Initialize database",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.cli", "init-db"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "FreshFlow: Import inventory CSV",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.cli", "import-csv", "data/inventory_mock_2026-10-12.csv"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "FreshFlow: Seed demo predictions and weather",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.cli", "seed-demo", "--date", "2026-10-12"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "FreshFlow: Verify reference data",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "app.cli", "verify-data"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "FreshFlow: Prepare demo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "FreshFlow: Initialize database",
        "FreshFlow: Import inventory CSV",
        "FreshFlow: Seed demo predictions and weather",
        "FreshFlow: Verify reference data"
      ],
      "problemMatcher": []
    },
    {
      "label": "FreshFlow: Run API",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "FreshFlow: Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
